rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() { return request.auth != null && request.auth.token.owner == true; }
    function uid() { return request.auth.uid; }

    // Vault data, including nested game records, is private to its owner.
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner() && uid() == userId;
    }

    // Provider entries are scoped to their creator even though they remain in
    // a top-level collection for compatibility with existing saved entries.
    match /providers/{providerId} {
      allow read: if isOwner() && resource.data.userId == uid();
      allow create: if isOwner() && request.resource.data.userId == uid();
      allow update: if isOwner()
        && resource.data.userId == uid()
        && request.resource.data.userId == uid();
      allow delete: if isOwner() && resource.data.userId == uid();
    }
  }
}
