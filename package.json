{
  "name": "game-hub",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint src eslint.config.js eslint-rules",
    "build": "tsc -b && vite build",
    "build:functions": "npm --prefix packages/functions run build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "deploy": "npm run build && firebase deploy",
    "deploy:web": "npm run build && firebase deploy --only hosting",
    "deploy:firestore": "firebase deploy --only firestore",
    "deploy:storage": "firebase deploy --only storage",
    "deploy:functions": "npm run build:functions && firebase deploy --only functions",
    "deploy:firebase": "firebase deploy",
    "test": "vitest run"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@gsap/react": "^2.1.2",
    "@monochrome-ai/core": "https://codeload.github.com/mustafabahaa/monochrome-ai/tar.gz/3ecabd9",
    "@monochrome-ui/design-system": "https://codeload.github.com/mustafabahaa/monochrome-ui/tar.gz/977bd33",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "@mui/x-charts": "^9.7.0",
    "@mui/x-date-pickers": "^9.7.0",
    "@tanstack/react-query": "^5.101.2",
    "date-fns": "^4.4.0",
    "firebase": "^11.10.0",
    "gsap": "^3.15.0",
    "iconsax-react": "^0.0.8",
    "notistack": "^3.0.2",
    "ogl": "^1.0.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12"
  }
}
