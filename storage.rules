rules_version = '2';

// GameHub Storage rules.
// Path conventions:
// - Game covers:      users/{uid}/gameImages/{accountId}/{imageId}.jpg
// - Provider photos:  users/{uid}/providerPhotos/{providerId}/{imageId}.jpg
//
// Vault images are private and accessible only to their owner.

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() { return request.auth != null && request.auth.token.owner == true; }
    function uid() { return request.auth.uid; }

    match /users/{userId}/{allPaths=**} {
      allow read, write: if isOwner() && userId == uid();
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
